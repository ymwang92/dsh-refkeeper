{
  "name": "dsh-refkeeper",
  "version": "0.1.1",
  "description": "Verify and export the references your AI conversation already cited: BibTeX/RIS with evidence-anchored annotations.",
  "author": "dsh-refkeeper contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymwang92/dsh-refkeeper.git"
  },
  "homepage": "https://github.com/ymwang92/dsh-refkeeper#readme",
  "bugs": {
    "url": "https://github.com/ymwang92/dsh-refkeeper/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "citation",
    "references",
    "bibtex",
    "ris"
  ],
  "license": "MIT",
  "type": "module",
  "icon": "./docs/images/icon.png",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "*"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs/images/icon.png",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "screenshots.json",
    "docs/images/panel.png",
    "docs/images/panel-en.png",
    "docs/images/composer-en.png",
    "docs/images/composer.png"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "build:host": "tsdown",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "tsdown": "^0.23.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
